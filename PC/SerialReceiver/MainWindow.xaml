<Window x:Class="SerialReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SerialReceiver"
        xmlns:conv="clr-namespace:SerialReceiver.Converters"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <conv:BoolToOpenCloseConverterConverters x:Key="BoolToOpenCloseConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ROW 0 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <DockPanel Height="55">
                <ComboBox Name="ComPortComboBox"
                          Width="200"
                          Height="25"
                          DockPanel.Dock="Bottom"
                          ItemsSource="{Binding AvailableComPorts}"
                          IsDropDownOpen="{Binding ShowComPortList}"
                          SelectedItem="{Binding SelectedComPort}"
                          SelectedIndex="{Binding SelectedComPortIndex}">
                </ComboBox>
                <Label Content="COM Port:" DockPanel.Dock="Bottom" Height="25" Margin="0,6,0,0">
                    <Label.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Refresh" Command="{Binding RefreshComPortsCommand}" />
                        </ContextMenu>
                    </Label.ContextMenu>
                </Label>
            </DockPanel>
            <DockPanel Height="55" Margin="10,0,0,0" >
                <TextBox Width="200" Text="{Binding BaudRate}" Height="25" DockPanel.Dock="Bottom"/>
                <Label Content="Baudrate:" DockPanel.Dock="Bottom" Height="25" Margin="0,6,0,0"/>
            </DockPanel>
            <DockPanel Height="55" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <ToggleButton Content="{Binding IsSerialPortClosed, Converter={StaticResource BoolToOpenCloseConverter}}"
                          Command="{Binding OpenCloseCommand}"
                          IsChecked="{Binding IsSerialPortClosed, Mode=OneWay}"
                          DockPanel.Dock="Bottom"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Width="50" Height="25"/>
            </DockPanel>
        </StackPanel>
        <!-- ROW 1 -->
        <Grid Grid.Row="1">
            <!-- Add your content here -->
        </Grid>
    </Grid>
</Window>
